size = 3) +
scale_x_continuous(breaks = seq(0, 80, by = 10)) +
scale_y_continuous(limits = c(0, 100), breaks = seq(0, 100, by = 10)) +
labs(
title    = "Ajuste: Modelo Logístico (GLM Logit)",
subtitle = "Extrapolación de prevalencia de atrofia gástrica para la tasa de incidencia de CG observada en Chile",
x        = "Incidencia (por 100.000 habs)",
y        = "Prevalencia (%)"
) +
theme_minimal()
fit_gc_metaplasia <- df_curvas_consolidadas %>%
filter(origen == "GC_IM.png") %>%
mutate(y_proporcion = y / 100)
# 2. Ajustamos el modelo logístico (GLM Binomial/Quasibinomial)
modelo_logistico_metaplasia <- glm(y_proporcion ~ x,
data   = fit_gc_metaplasia,
family = quasibinomial(link = "logit"))
# 3. Calculamos la prevalencia estimada para Chile (multiplicamos por 100 para volver a %)
pred_chile_metaplasia <- predict(modelo_logistico_metaplasia,
newdata = data.frame(x = tasa_gral),
type    = "response") * 100
# Ver el valor estimado para Chile
cat("La prevalencia estimada de metaplasia intestinal para la tasa de incidencia de cáncer gástrico", tasa_gral, "es:", round(pred_chile_metaplasia, 2), "%\n")
# 1. Creamos un vector denso de incidencia que vaya desde 0 hasta 80 para ver el futuro de la curva
df_proyeccion_metaplasia <- data.frame(x = seq(0, 95, length.out = 300))
# 2. Predecimos la curva completa en porcentaje
df_proyeccion_metaplasia$y_pred <- predict(modelo_logistico_metaplasia,
newdata = df_proyeccion_metaplasia,
type    = "response") * 100
# 3. Graficamos
ggplot() +
# Puntos originales que digitalizaste (rango 0-32)
geom_point(data = fit_gc_metaplasia,
aes(x = x,
y = y),
color = "black",
size  = 2.5,
alpha = 0.7) +
# La curva logística proyectada hasta 80
geom_line(data = df_proyeccion_metaplasia,
aes(x     = x,
y     = y_pred),
color     = "darkgreen",
linewidth = 1.2) +
# Línea de referencia vertical para la tasa real de Chile
geom_vline(xintercept = tasa_gral,
linetype   = "dashed",
color      = "red",
linewidth  = 0.8) +
# Punto de predicción Chile
annotate("point",
x     = tasa_gral,
y     = pred_chile_metaplasia,
color = "red",
size  = 4,
shape = 18) +
annotate("text",
x        = tasa_gral + 2,
y        = pred_chile_metaplasia,
label    = paste0("Chile: ", round(pred_chile_metaplasia, 1), "%"),
color    = "red",
hjust    = 0,
fontface = "bold") +
annotate("rect",
xmin = max(fit_gc_metaplasia$x),
xmax = 95,
ymin = 0,
ymax = 100,
alpha = 0.08,
fill = "orange") +
annotate("text",
x = max(fit_gc_metaplasia$x) + 1,
y = 95,
label = "Área de extrapolación",
color = "orange3",
hjust = 0,
size = 3) +
# Estética del gráfico
scale_x_continuous(breaks = seq(0, 80, by = 10)) +
scale_y_continuous(limits = c(0, 100), breaks = seq(0, 100, by = 10)) +
labs(
title    = "Ajuste: Modelo Logístico (GLM Logit)",
subtitle = "Extrapolación de Prevalencia de Metaplasia Intestinal para la tasa de incidencia de CG observada en Chile",
x        = "Incidencia (por 100.000 habs)",
y        = "Prevalencia (%)"
) +
theme_minimal()
