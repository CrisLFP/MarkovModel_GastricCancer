library(haven)
library(readxl)
library(tidyverse)
RPC <- read_sav("~/Desktop/U_CHILE/MG_BIOESTADÍSTICA/TESIS/DATOS PÚBLICOS/REGISTRO POBALCIONAL DE CÁNCER/BBDD_RPC_1998-2019_ID.sav") %>%
mutate(
Fecnac = case_when(
## SPSS date format
grepl("^[0-9]+$", Fecnac) ~ as.character(as.Date(as.numeric(Fecnac), origin = "1899-12-30")),
## extrem dates code in right way
grepl("^[0-9]{2}-[0-9]{2}-[0-9]{4}$", Fecnac) ~ as.character(as.Date(Fecnac, format = "%d-%m-%Y")),
TRUE ~ NA_character_ ), Fecnac = as.Date(Fecnac) ) %>%
## variable selection
dplyr::select(
id_persona, RPC, regCom, Sexo, Edad, Quinquenios_edad, Grupo_edad_1, Fecnac, Fecdiag, Año_diag, CIE10, Nombre_Cancer, Grupo_diag_1, Morfologia, Comportamiento, Base_diagnostico, VM)   %>%
rename(CODIGO_COMUNA = regCom) %>%
## Modificación del formato variables
mutate(
CODIGO_COMUNA            = as.numeric(CODIGO_COMUNA),
Sexo                     = as.factor(Sexo),
Quinquenios_edad         = as.factor(Quinquenios_edad),
Quinquenios_edad         = fct_recode(Quinquenios_edad,
"0-4" = "1",
"5-9" = "2",
"10-14" = "3",
"15-19" = "4",
"20-24" = "5",
"25-29" = "6",
"30-34" = "7",
"35-39" = "8",
"40-44" = "9",
"45-49" = "10",
"50-54" = "11",
"55-59" = "12",
"60-64" = "13",
"65-69" = "14",
"70-74" = "15",
"75-79" = "16",
"80 y más"  = "17" ),
Año_diag                 = as.numeric(Año_diag),
CIE10                    = as.factor(CIE10),
Nombre_Cancer            = as.factor(Nombre_Cancer),
Morfologia               = as.factor(Morfologia),
Comportamiento           = as.factor(Comportamiento),
Sexo                     = factor(Sexo),
Sexo                     = fct_recode(Sexo,
"Hombre" = "1", "Mujer" = "2" ),
Base_diagnostico = as.factor(Base_diagnostico),
Base_diagnostico = fct_recode(Base_diagnostico,
"Death certifite only"       = "0",
"Clinical"                   = "1",
"Clínical investigacion"     = "2",
"Specific tumor markers"     = "4",
"Cytology"                   = "5",
"Histology of metastasis"    = "6",
"Histology of primary tumor" = "7",
"Unknown"                    = "9"))   %>%
rename(AÑO = Año_diag) %>%
## filter by CIE10 code
filter(substr(CIE10,              ## imput
1,                  ## start
3) == "C16") %>%    ## stop
droplevels()                      ## drop levels unused
table(RPC$CIE10)
View(RPC)
