x_eval <- readRDS("~/Documents/GitHub/MarkovModel_GastricCancer/3. CALIBRATION MODEL/CALIBRATION TARGETS/INCIDENCIA CANCER/serie_CG_estimacion_asr.rds")
View(x_eval)
#| label: carga de libreria
library(readr)
library(tidyverse)
#| label: carga de datos Zitko
options(scipen = 999)                         # quitar notacion cientifica en df
dat <- read_csv("Incidencia_CaEstomago.csv")
#| label: creación función para simular conteos de cáncer gástrico, por Zitko P
## Definir la función de Zitko:
## simula N conteos desde una lognormal cuya media y varianza (escala original)
## son mu y va. Convierte mu/va a meanlog/sdlog (moment matching) y
## sortea con rlnorm. Base de toda la propagación de incertidumbre que sigue.
# 1. distribución logNorm -> simular conteo
DistrLOGNORM = function(mu,     # media
va,     # varianza
N) {    # valores aleatorios de una lognormal
## volver la media en log media
Me = log( (mu^2) / (sqrt (va + mu^2)) )
## convertir la varianza en log sd
Va = sqrt( log ( 1 + (va / (mu^2))) )
mapply(rlnorm,                # rlnorm usa la media y varianza en escala log
N,                     # valores aleatorios
Me,                    # mean log
Va)                    # sd log
}
#| label: calculo de tasa nacional, por Zitko P
## Tasa cruda nacional por año (todas las edades).
## E = casos/año (suma de Incidencia)
## P = población/año,
## R = E/P*1e5.
## Luego IC por Monte Carlo: 1000 réplicas lognormales por celda (EE),
## se suman por año (ICp) y se ob  percentiles 2.5/97.5 (IC empirico).
## Salida = casos+IC
## Salida_Tasa = tasa+IC.
set.seed(1989)
# 2. load base pob provincias 1998-2035
datP <- read_csv("CODES/Base Pob Provincia 1998a2035.csv")
# 3. calcular incidencias por año
E           =	tapply	(	dat$Incidencia, dat$Ano, sum)  # calcular casos por año
P           =	tapply	(	datP$Pob, datP$Ano, sum)       # calcular poblacion por año
R           =	(E/P)*100000                             # calcular tasa cruda por año
## propagacion de incertidumbre con método de MonteCarlo
## matriz de tantas columnas como filas tiene dat X 1000 filas de simulaciones
EE          =	mapply	(DistrLOGNORM,                   # aplicar función DistrLOGNORM
dat$Incidencia,                  # mu = casos incidentes
((dat$ICS - dat$ICI)/2/1.96)^2,  # va = calculo de la varianza a partir de los IC 95%
# ((LS-LI)/2)/1.96)^2
1000)                            # N = 1000 replicas
## recorrer matriz EE, simulacion por simulacion (aply())
## en cada simulación sumar los casos simulados por año (taply())
ICp         =	apply	(EE, 1, function (x) tapply (x, dat$Ano, sum)) # 1000 estimaciones de casos por año
## tomar las 1000 estimacion y calcular los p25 y p75 (IC 95% empírico)
IC          =	apply	(ICp, 1, quantile, c(0.025, 0.975))
## tabla con casos totales junto a los IC empíricos
Salida      =	cbind( E, t(IC))
## tabla con tasa para cada año, junto a los IC empíricos
Salida_Tasa =	cbind( R, (t(IC)/cbind(P,P)*100000))
#| label: plots
## Dos gráficos base-R (casos y tasa) 1998-2035: lienzo vacío,
## banda de IC con polygon (ida con LI, vuelta con LS) y
## línea central con la estimación puntual.
## plot casos
plot	(	-100,
-100,
xlab = "Año",
ylab= "Casos incidentes de Cáncer Gástrico",
xlim=c(1998,2035),
ylim=c(0, max(E)*1.1))
polygon 	(	c(1998:2035,
rev(1998:2035)),
c(Salida[,2], rev(Salida [,3])),
col =	hsv(1,0.25,0.25,0.15),
border = NA)
lines	(	1998:2035,
Salida[,1],
lwd = 2,
col = 1)
## plot tasa
plot	(	-100,
-100,
xlab = "Año",
ylab = "Tasa de incidencia de Cáncer Gástrico [x100.000]",
xlim = c(1998,2035),
ylim = c(0, max(R)*1.1))
polygon 	(	c(1998:2035,
rev(1998:2035)),
c(Salida_Tasa[,2],
rev(Salida_Tasa [,3])),
col =	hsv(1,0.25,0.25,0.15),
border = NA)
lines	(	1998:2035,
Salida_Tasa[,1],
lwd = 2,
col = 1)
#| label: compilacion en tidy
## Pasa Salida y Salida_Tasa a data.frame, renombra columnas (casos/tasa +
## LI95/LS95), las une y agrega la columna año. Guarda CG_estimacion.rds.
casos <- as.data.frame(Salida) %>%
rename(
casos       = "E",
casos_LI95  = "2.5%",
casos_LS95  = "97.5%"
)
tasas <- as.data.frame(Salida_Tasa) %>%
rename(
tasa       = "R",
tasa_LI95  = "2.5%",
tasa_LS95  = "97.5%"
)
CG_estimacion <- bind_cols(
casos,
tasas) %>%
mutate(
año = 1998:2035
)
saveRDS(CG_estimacion, file = "CG_estimacion.rds")
#| label: calculo de tasa por edad, en el año 2022
## Filtra 2022.
## EC = casos por edad (código 1-18)
## P  = población por edad,
## R  = EC/P*1e5 -> tasa específica por quinquenio de edad, año 2022.
dat_2022  <- dat[dat$Ano == 2022, ]    # tomar tasas del año
datP_2022 <- datP[datP$Ano == 2022, ]  # tomar poblaciones del año
# Incidencia por Año y Edad
EC =	tapply	(	dat_2022$Incidencia,
list(dat_2022$Ano,
dat_2022$Edad),
sum)
# Población por Año y Edad
P  =	tapply	(	datP_2022$Pob,
list(datP_2022$Ano,
datP_2022$Edad),
sum)
# tasa específica por año y grupo de edad (1:18)
R  =	(EC/P)*100000
#| label: tasa por edad 2022 + incertidumbre
## Réplicas lognormales para 2022 (EEC), IC por edad, y armar Salida/Salida_Tasa.
## Colapsar los códigos a 6 grupos (20-39 ... 80-99) y calcular incidencia agrupada
## con IC. NOTA: Poblacion = c(R)*1e5/c(R) = constante 100000 (no es población
## real); funciona solo porque Casos = c(R) y la constante se cancela ->
## equivale a promedio ponderado por esa constante.
set.seed(1989)
EEC =	mapply	(DistrLOGNORM,
dat_2022$Incidencia,
((dat_2022$ICS - dat_2022$ICI)/2/1.96)^2,
1000)
ICp =	apply	(EEC, 1,
function (x) tapply (x, list(dat_2022$Ano, dat_2022$Edad),sum))
IC  = apply	(ICp, 1, quantile, c(0.025, 0.975))
da          =	expand.grid	(Ano = rownames(EC), Edad = colnames(EC))
Salida      =	cbind( da, c(EC), t(IC))
Salida_Tasa =	cbind( da, c(R), (t(IC)/cbind(c(P),c(P))*100000))
# Para copiar y pegar en excel
write.table(Salida, dec = ",")
write.table(Salida_Tasa, dec = ",")
Salida_Tasa <- Salida_Tasa %>%
mutate(
Edad = as.numeric(Edad),
GrupoEdad = case_when(
Edad %in% 6:9   ~ "20-39",
Edad %in% 10:11 ~ "40-49",
Edad %in% 12:13 ~ "50-59",
Edad %in% 14:15 ~ "60-69",
Edad %in% 16:17 ~ "70-79",
Edad == 18      ~ "80-99",
TRUE ~ NA_character_
)
) %>%
filter(!is.na(GrupoEdad))
# Step 2: Estimate population (assumed from rate and cases, can be replaced by real population if available)
Salida_Tasa <- Salida_Tasa %>%
mutate(
Poblacion   = `c(R)` * 100000 / `c(R)`,  # Simplifies to any constant P you may have
Casos       = `c(R)` / 100000 * Poblacion,
Casos_Lower = `2.5%` / 100000 * Poblacion,
Casos_Upper = `97.5%` / 100000 * Poblacion
)
# Step 3: Group and compute incidence and confidence intervals
IncidenciaAgrupada <- dplyr::group_by(Salida_Tasa, GrupoEdad) %>%
dplyr::summarise(
Incidencia = sum(Casos) / sum(Poblacion) * 100000,
IC_Lower   = sum(Casos_Lower) / sum(Poblacion) * 100000,
IC_Upper   = sum(Casos_Upper) / sum(Poblacion) * 100000,
.groups    = "drop"
)
# View the resulting data frame
print(IncidenciaAgrupada)       ## 20-39; 40-49; 50-59; 60-69; 70-79; 80-99
saveRDS(IncidenciaAgrupada, file = "CG_estimacion_edad.rds")
#| label: tasa estandarizada para un año particular - estimación puntual
## ASR determinista por año (estándar Segi colapsado a 7 grupos, incluye 0-19
## con peso 40000). Une dat+datP por las 4 claves, colapsa, tasa por grupo,
## pondera por Segi: ASR = sum(tasa*w)/sum(w). Produce pais_data_agrupado_calc.
# link pob standarizada (ASR): https://gco.iarc.who.int/overtime/en/about
## pob estandarizada segi original.
segi_w <- c(12000,  ## 1 (0-4)
10000,  ## 2 (5-9)
9000,   ## 3 (10-14)
9000,   ## 4 (15-19)
8000,   ## 5 (20-24)
8000,   ## 6 (25-29)
6000,   ## 7 (30-34)
6000,   ## 8 (35-39)
6000,   ## 9 (40-44)
6000,   ## 10 (45-49)
5000,   ## 11 (50-54)
4000,   ## 12 (55-59)
4000,   ## 13 (60-64)
3000,   ## 14 (65-69)
2000,   ## 15 (70-74)
1000,   ## 16 (75-79)
500,    ## 17 (80-84)
500)    ## 18 (+85)
# segi colapsado a Poblaciones usadas por Zitko P
segi_colapsado <- data.frame(
GrupoEdad =  c("0-19",  "20-39",
"40-49", "50-59",
"60-69", "70-79",
"80-99"),
Pob = c(
40000, # Suma de Segi 1 al 4 (12k + 10k + 9k + 9k)
28000, # Suma de Segi 5 al 8 (8k + 8k + 6k + 6k)
12000, # Suma de Segi 9 y 10 (6k + 6k)
9000,  # Suma de Segi 11 y 12 (5k + 4k)
7000,  # Suma de Segi 13 y 14 (4k + 3k)
3000,  # Suma de Segi 15 y 16 (2k + 1k)
1000   # Suma de Segi 17 y 18 (500 + 500)
))
## tasas
dat_y <- dat %>%
select(Edad, Sexo, Provincia, Ano, Incidencia)
## Poblacion
datP_y <- datP %>%
select(Edad, Sexo, Provincia, Ano, Pob)
## unir datos de pob y data
df_dat <- dat_y %>%
left_join(datP_y, by = c("Edad", "Sexo", "Provincia", "Ano"))
stopifnot(!anyNA(df_dat$Pob)) ## detener si hay NAs en poblacion
pais_data_agrupado <- df_dat %>%
mutate(GrupoEdad = case_when(
Edad %in% 1:5   ~ "0-19",    ## colpaso de niveles para coincidir con Pob Segi
Edad %in% 6:9   ~ "20-39",   ## niveles Zitko
Edad %in% 10:11 ~ "40-49",
Edad %in% 12:13 ~ "50-59",
Edad %in% 14:15 ~ "60-69",
Edad %in% 16:17 ~ "70-79",
Edad == 18      ~ "80-99",
TRUE ~ NA_character_
)) %>%
filter(!is.na(GrupoEdad)) %>%
group_by(GrupoEdad, Ano) %>%
summarise(
casos_totales = sum(Incidencia, na.rm = TRUE),
pob_total     = sum(Pob, na.rm = TRUE),
.groups       = "drop"
) %>%
# Convertir a factor para ordenar  los vectores
mutate(GrupoEdad = factor(GrupoEdad)) %>%
arrange(GrupoEdad) %>%
mutate(tasa_edad = casos_totales / pob_total * 100000)
# Multiplicación matricial y cálculo ASR final
pais_data_agrupado_calc <- pais_data_agrupado %>%
left_join(segi_colapsado, by = "GrupoEdad") %>%
group_by(Ano) |>
summarise(
ASR = sum(tasa_edad * Pob, na.rm = TRUE) / sum(Pob, na.rm = TRUE)
)
saveRDS(pais_data_agrupado_calc, file = "CG_estimacion_asr.rds")
#| label: tasa con incertidumbre, como Ztiko
## IC de la ASR nacional 2022 por propagación Monte Carlo (réplicas de Zitko)
## Misma ASR pero repetida sobre las 1000 réplicas:
## pega réplicas a dat, une población, colapsa a 7 grupos,
## ASR por réplica y año (asr_mat 38x1000) -> mediana e IC empírico (asr_replicas).
## Une con el punto determinista (pais_data_agrupado_calc) en asr_serie.
## Guarda serie_CG_estimacion_asr.rds.
## La población es fija; sólo se simulan los casos.
## Segi colapsado (idéntico al del punto)
segi_colapsado <- data.frame(
GrupoEdad = c("0-19",
"20-39",
"40-49",
"50-59",
"60-69",
"70-79",
"80-99"),
Pob       = c(40000,
28000,
12000,
9000,
7000,
3000,
1000)
)
## 1. Trasponer EE -> 76608 filas (celda-año) x 1000 réplicas
EE_t <- t(EE)
stopifnot(nrow(EE_t) == nrow(dat))   # 76608 == 76608; alineación
##  2. Pegar réplicas a dat completo ANTES del join (Ano viaja pegado)
n_rep     <- ncol(EE_t)
rep_cols  <- as.data.frame(EE_t)
rep_names <- paste0("rep_", seq_len(n_rep))
names(rep_cols) <- rep_names
dat_rep <- dplyr::bind_cols(
dat %>% select(Edad, Sexo, Provincia, Ano),
rep_cols
)
## 3. Unir población (varía por año) por las 4 claves
datP_y <- datP %>% select(Edad, Sexo, Provincia, Ano, Pob)
df_rep <- dat_rep %>%
left_join(datP_y, by = c("Edad","Sexo","Provincia","Ano"))
stopifnot(!anyNA(df_rep$Pob))
## 4. Mapear a los 7 grupos
df_rep <- df_rep %>%
mutate(GrupoEdad = case_when(
Edad %in% 1:5   ~ "0-19",
Edad %in% 6:9   ~ "20-39",
Edad %in% 10:11 ~ "40-49",
Edad %in% 12:13 ~ "50-59",
Edad %in% 14:15 ~ "60-69",
Edad %in% 16:17 ~ "70-79",
Edad == 18      ~ "80-99",
TRUE ~ NA_character_
)) %>%
filter(!is.na(GrupoEdad))
## 5. Agregar a nacional por (GrupoEdad x Ano): casos por réplica y población
casos_ga <- df_rep %>%
group_by(Ano, GrupoEdad) %>%
summarise(across(all_of(rep_names), ~ sum(.x, na.rm = TRUE)), .groups = "drop")
pob_ga <- df_rep %>%
group_by(Ano, GrupoEdad) %>%
summarise(pob_total = sum(Pob, na.rm = TRUE), .groups = "drop")
## alinear casos, pob y Segi por (Ano, GrupoEdad)
casos_ga <- casos_ga %>% arrange(Ano, GrupoEdad)
pob_ga   <- pob_ga   %>% arrange(Ano, GrupoEdad)
casos_ga <- casos_ga %>% left_join(segi_colapsado,
by = "GrupoEdad")
stopifnot(all(casos_ga$Ano == pob_ga$Ano),
all(casos_ga$GrupoEdad == pob_ga$GrupoEdad))
## 6. ASR por réplica y por año
## tasa = casos/pob*1e5 ; ASR_ano = sum(tasa*w_segi)/sum(w_segi) dentro de cada año
M_casos <- as.matrix(casos_ga[, rep_names])          # (7*38) filas x 1000 réplicas
tasas   <- (M_casos / pob_ga$pob_total) * 100000     # recicla pob por columna
tasas_w <- tasas * casos_ga$Pob                      # ponderar por Segi (Pob = peso)
## sumar numerador y denominador por año
asr_por_ano <- data.frame(Ano = casos_ga$Ano,
casos_ga$GrupoEdad,
tasas_w,
check.names = FALSE) |>
as.data.frame()
## numerador (sum tasa*w por año) y denominador (sum w por año), por réplica
num_ano <- rowsum(tasas_w,                 group = casos_ga$Ano)    # 38 años x 1000
den_ano <- rowsum(casos_ga$Pob,            group = casos_ga$Ano)    # 38 años x 1
asr_mat <- num_ano / as.numeric(den_ano)                            # 38 años x 1000 réplicas
##  7. Resumen por año: punto (mediana) e IC empírico
asr_det <- pais_data_agrupado_calc %>%
rename(ASR_determinista = ASR)
asr_replicas <- data.frame(
Ano             = as.numeric(rownames(asr_mat)),
ASR_mediana_rep = apply(asr_mat, 1, median),
ASR_LI95        = apply(asr_mat, 1, quantile, 0.025),
ASR_LS95        = apply(asr_mat, 1, quantile, 0.975),
ASR_sd          = apply(asr_mat, 1, sd)
)
asr_serie <- asr_det %>%
left_join(asr_replicas, by = "Ano") %>%
arrange(Ano)
print(asr_serie)
saveRDS(asr_serie, "serie_CG_estimacion_asr.rds")
library(readr)
